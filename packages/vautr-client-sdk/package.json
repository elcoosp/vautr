{
  "name": "@vautr/client-sdk",
  "version": "0.1.0",
  "description": "Promise-based TypeScript SDK wrapping the Vautr WASM worker bridge (data.md primitive mapping, u64 as string).",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./real": {
      "types": "./dist/realClient.d.ts",
      "default": "./dist/realClient.js"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "default": "./dist/mobile.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:pact": "vitest run test/pact"
  },
  "dependencies": {
    "@vautr/api-contract": "workspace:*",
    "@vautr/ui-logic": "workspace:*"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^14.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
