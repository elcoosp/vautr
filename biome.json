{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!core",
      "!brand",
      "!docs",
      "!target",
      "!node_modules",
      "!dist",
      "!**/routeTree.gen.ts",
      "!**/vautr_wasm.js",
      "!**/vautr_wasm.d.ts",
      "!**/generated.ts",
      "!**/.hermes",
      "!packages/design-tokens/tokens.css",
      "!packages/design-tokens/tokens.ts",
      "!packages/design-tokens/tokens.md",
      "!packages/design-tokens/tokens.json",
      "!apps/desktop/src/theme_tokens.rs",
      "!apps/mobile/ios",
      "!**/pacts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error",
        "noUnknownAtRules": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/e2e/**",
        "**/tests/**",
        "**/test/**",
        "**/load/**",
        "**/scripts/**",
        "**/globalSetup.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["**/wasm*.ts", "**/wasm*.js", "**/wasm*.d.ts", "packages/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
