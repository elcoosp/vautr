{
  "name": "vautr",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @vautr/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare:wasm": "bash scripts/prepare-wasm.sh",
    "verify:wasm": "node scripts/check-wasm.mjs",
    "rec:demo": "recordable demos/vautr-demo.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "recordable": "^0.10.0",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "metro": "0.87.0",
      "metro-transform-worker": "0.87.0",
      "metro-transform-plugins": "0.87.0",
      "metro-runtime": "0.87.0",
      "metro-core": "0.87.0",
      "metro-config": "0.87.0",
      "metro-resolver": "0.87.0",
      "metro-babel-transformer": "0.87.0",
      "metro-cache": "0.87.0",
      "metro-cache-key": "0.87.0",
      "metro-file-map": "0.87.0",
      "metro-source-map": "0.87.0",
      "metro-minify-uglify": "0.87.0",
      "metro-minify-terser": "0.87.0",
      "metro-react-native-babel-preset": "0.87.0",
      "metro-react-native-babel-transformer": "0.87.0"
    },
    "onlyBuiltDependencies": [
      "ffmpeg-static"
    ]
  }
}
