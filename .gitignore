# Local dev-database backups (not part of the product)
.db-backups/

# Server backup-export artifacts (test run output, not product code)
backups/

# k6 load-test seeded SQLite DB (test/load/.loadtest/) — generated by seed_db.sh
test/.loadtest/
.loadtest/

# Pact consumer contract artifacts (generated by packages/vautr-client-sdk/test/pact)
**/pacts/

# cargo-fuzz corpora (regression seeds, regenerated by `cargo fuzz run`)
**/fuzz/corpus/
**/fuzz/artifacts/

# Vautr uniffi prebuilt static lib (293MB) — regenerated via
# `cargo build -p vautr-ffi --target aarch64-apple-ios-sim`.
packages/native/ios/libvautr_ffi.a
apps/mobile/ios/VautrNativeModule-src/libvautr_ffi.a

# Vautr uniffi prebuilt Android shared lib — regenerated via
# `cargo ndk -t arm64-v8a -o packages/native/android/src/main/jniLibs build -p vautr-ffi --release`.
packages/native/android/src/main/jniLibs/

# Real (non-symlinked) copy of the iOS pod sources used by the Podfile's
# `pod 'VautrNativeModule', :path => '../VautrNativeModule-src'`. Contains a
# 293MB libvautr_ffi.a; recreated from packages/native/ios after clean clone.
apps/mobile/VautrNativeModule-src/

# Expo prebuild native output (regenerated by `expo prebuild`). Keep the
# Podfile (it wires the uniffi VautrNativeModule via :path) and
# Podfile.properties.json tracked; ignore the rest.
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/ios/DerivedData/
apps/mobile/ios/*.xcodeproj/
apps/mobile/ios/*.xcworkspace/
apps/mobile/android/

# Gradle build output for the @vautr/native Android module.
packages/native/android/build/

# Expo dev/build generated artifacts
apps/mobile/.expo/

# Local dev-environment notes (port map, agent conventions) — not product source
AGENTS.md
