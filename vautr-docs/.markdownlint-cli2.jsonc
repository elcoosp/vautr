{
	"config": {
		"default": true,
		"MD013": false,
		"MD033": {
			"allowed_elements": ["Aside", "Tabs", "TabItem", "Card", "CardGrid", "LinkCard", "code", "img", "br"]
		},
		"MD041": false,
		"MD024": {
			"siblings_only": true
		},
		"MD025": false,
		"MD028": false,
		"MD046": false
	},
	"globs": ["src/content/docs/**/*.{md,mdx}"],
