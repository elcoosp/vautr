      "vautr-wasm": [
        "../web/src/lib/wasm.ts"
      ],
      "vautr-wasm-nodejs": [
        "../extension/src/lib/wasmNodejs.ts"
      ]
    }
  },
  "include": [
    "App.tsx",
    "index.ts",
    "src",
    "lib",
